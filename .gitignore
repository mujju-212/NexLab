# ── Folders to EXCLUDE from git entirely ──────────────────────────────
# (docs, planning, research papers are local working notes only)
docs/
planning/
research papers/
INDEX.md

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/

# ── Virtual environment ─────────────────────────────────────────────────
backend/venv/
backend/env/
frontend/node_modules/

# ── Next.js build output & caches ───────────────────────────────────────
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# ── Secrets — NEVER commit ─────────────────────────────────────────────
backend/.env
*.env.local
*.env.production

# ── ML Models — rebuilt from training ──────────────────────────────────
backend/ml_models/*.pkl
backend/ml_models/*.joblib

# ── Datasets — raw data, often large ───────────────────────────────────
backend/ml_training/datasets/

# ── Database ────────────────────────────────────────────────────────────
*.db
*.sqlite3
backend/instance/

# ── Docker generated volumes ────────────────────────────────────────────
backend/docker/postgres_data/
backend/docker/redis_data/

# ── Runtime output directories ──────────────────────────────────────────
backend/app/reports_out/
backend/.pip_cache/

# ── Logs ────────────────────────────────────────────────────────────────
*.log
logs/

# ── IDE ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Test artifacts ───────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── Dev tools — not part of the project ─────────────────────────────────
graphify-out/
graphify_step_*.py
.agents/
.qoder/
nul
*_colors.py

# ── Exec-engine scratch & debug artifacts ───────────────────────────────
# Throwaway Dockerfile/project probes used when bringing up a new language
# image, plus the stderr dump and JSON scratch output from smoke runs.
backend/_cs_probe/
backend/_cs_test/
backend/_verify_result.json
backend/backend.err
backend/test_out.txt

# Generated per-run HTML simulation output (browser-engine languages)
backend/simulations/

# Ad-hoc manual test harness pages
backend/static/test_ui.html
backend/app/static/test_ui.html

# Editor scratch files
**/Untitled-*.txt

# ── Local runtime pids, errs & test artifacts ───────────────────────────
*.pid
*.err
test_results.json
check_models.py
backend/test_session_notification.py

