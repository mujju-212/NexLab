# ─────────────────────────────────────────────────────────────────────────────
# VIRTUAL LAB PLATFORM — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development                         # development | production
SECRET_KEY=change-this-to-a-random-secret
JWT_SECRET_KEY=change-this-to-another-secret
JWT_ACCESS_TOKEN_EXPIRES=86400               # 24 hours in seconds

# Database (PostgreSQL via Supabase or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtuallab

# Code Execution (Docker engine)
DOCKER_RUNNER_ENABLED=false                  # true to enable /run and /playground
# DOCKER_BIN=docker                          # override if docker is not on PATH

# Groq API (AI hints, viva, help chat)
GROQ_API_KEY=gsk_your_key_here
GROQ_DAILY_LIMIT_PER_INSTITUTION=500

# Cloudinary (file storage: videos, PDFs, images, lab records)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (optional for MVP — used for Groq quota tracking)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false                              # false = use DB for quota tracking

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Jitsi (for live session video — using free meet.jit.si)
JITSI_DOMAIN=meet.jit.si

# Server base URL (used in email links and callbacks)
BASE_URL=http://localhost:5000
